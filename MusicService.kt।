
package com.joymusicplayer

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.Intent
import android.media.MediaPlayer
import android.net.Uri
import android.os.Build
import android.os.IBinder
import androidx.core.app.NotificationCompat

class MusicService : Service() {

    companion object {
        const val ACTION_PLAY_QUEUE = "joy.play.queue"
        const val ACTION_TOGGLE = "joy.play.toggle"
        const val ACTION_NEXT = "joy.play.next"
        const val ACTION_PREVIOUS = "joy.play.previous"

        const val EXTRA_URIS = "song_uris"
        const val EXTRA_TITLES = "song_titles"
        const val EXTRA_ARTISTS = "song_artists"
        const val EXTRA_INDEX = "song_index"

        private const val CHANNEL_ID = "joy_music_playback"
        private const val NOTIFICATION_ID = 101
    }

    private var player: MediaPlayer? = null
    private var uris = arrayListOf<String>()
    private var titles = arrayListOf<String>()
    private var artists = arrayListOf<String>()
    private var currentIndex = 0
    private var isPrepared = false

    override fun onBind(intent: Intent?): IBinder? = null

    override fun onCreate() {
        super.onCreate()
        createNotificationChannel()
    }

    override fun onStartCommand(
        intent: Intent?,
        flags: Int,
        startId: Int
    ): Int {
        // Start foreground immediately for media playback.
        startForeground(NOTIFICATION_ID, buildNotification())

        when (intent?.action) {
            ACTION_PLAY_QUEUE -> {
                uris = intent.getStringArrayListExtra(EXTRA_URIS)
                    ?: arrayListOf()
                titles = intent.getStringArrayListExtra(EXTRA_TITLES)
                    ?: arrayListOf()
                artists = intent.getStringArrayListExtra(EXTRA_ARTISTS)
                    ?: arrayListOf()
                currentIndex = intent.getIntExtra(EXTRA_INDEX, 0)
                    .coerceIn(0, (uris.size - 1).coerceAtLeast(0))

                playCurrent()
            }

            ACTION_TOGGLE -> togglePlayback()
            ACTION_NEXT -> playNext()
            ACTION_PREVIOUS -> playPrevious()
        }

        return START_NOT_STICKY
    }

    private fun playCurrent() {
        if (uris.isEmpty()) {
            stopPlayback()
            return
        }

        releasePlayer()
        isPrepared = false

        try {
            player = MediaPlayer().apply {
                setDataSource(
                    this@MusicService,
                    Uri.parse(uris[currentIndex])
                )

                setOnPreparedListener { mp ->
                    isPrepared = true
                    mp.start()
                    updateNotification()
                }

                setOnCompletionListener {
                    playNext()
                }

                setOnErrorListener { mp, _, _ ->
                    mp.release()
                    if (player === mp) player = null
                    isPrepared = false
                    updateNotification()
                    true
                }

                prepareAsync()
            }
        } catch (_: Exception) {
            releasePlayer()
            updateNotification()
        }

        updateNotification()
    }

    private fun togglePlayback() {
        val mp = player

        if (mp != null && isPrepared) {
            if (mp.isPlaying) {
                mp.pause()
            } else {
                mp.start()
            }
            updateNotification()
        }
    }

    private fun playNext() {
        if (uris.isEmpty()) return
        currentIndex = (currentIndex + 1) % uris.size
        playCurrent()
    }

    private fun playPrevious() {
        if (uris.isEmpty()) return
        currentIndex = if (currentIndex == 0) {
            uris.size - 1
        } else {
            currentIndex - 1
        }
        playCurrent()
    }

    private fun releasePlayer() {
        isPrepared = false
        player?.setOnPreparedListener(null)
        player?.setOnCompletionListener(null)
        player?.setOnErrorListener(null)
        player?.release()
        player = null
    }

    private fun stopPlayback() {
        releasePlayer()
        stopForeground(STOP_FOREGROUND_REMOVE)
        stopSelf()
    }

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                CHANNEL_ID,
                "Music playback",
                NotificationManager.IMPORTANCE_LOW
            ).apply {
                description = "Playback controls for Joy Music Player"
            }

            getSystemService(NotificationManager::class.java)
                .createNotificationChannel(channel)
        }
    }

    private fun actionPendingIntent(
        action: String,
        requestCode: Int
    ): PendingIntent {
        val intent = Intent(this, MusicService::class.java).apply {
            this.action = action
        }

        return PendingIntent.getService(
            this,
            requestCode,
            intent,
            PendingIntent.FLAG_UPDATE_CURRENT or
                PendingIntent.FLAG_IMMUTABLE
        )
    }

    private fun buildNotification(): Notification {
        val title = titles.getOrNull(currentIndex) ?: "Joy Music Player"
        val artist = artists.getOrNull(currentIndex) ?: "Music"

        val isPlaying = try {
            isPrepared && player?.isPlaying == true
        } catch (_: Exception) {
            false
        }

        val openApp = PendingIntent.getActivity(
            this,
            10,
            Intent(this, MainActivity::class.java),
            PendingIntent.FLAG_UPDATE_CURRENT or
                PendingIntent.FLAG_IMMUTABLE
        )

        return NotificationCompat.Builder(this, CHANNEL_ID)
            .setSmallIcon(android.R.drawable.ic_media_play)
            .setContentTitle(title)
            .setContentText(artist)
            .setContentIntent(openApp)
            .setVisibility(NotificationCompat.VISIBILITY_PUBLIC)
            .setOnlyAlertOnce(true)
            .setOngoing(isPlaying)
            .addAction(
                android.R.drawable.ic_media_previous,
                "Previous",
                actionPendingIntent(ACTION_PREVIOUS, 11)
            )
            .addAction(
                if (isPlaying) android.R.drawable.ic_media_pause
                else android.R.drawable.ic_media_play,
                if (isPlaying) "Pause" else "Play",
                actionPendingIntent(ACTION_TOGGLE, 12)
            )
            .addAction(
                android.R.drawable.ic_media_next,
                "Next",
                actionPendingIntent(ACTION_NEXT, 13)
            )
            .build()
    }

    private fun updateNotification() {
        val manager = getSystemService(
            NotificationManager::class.java
        )
        manager.notify(NOTIFICATION_ID, buildNotification())
    }

    override fun onDestroy() {
        releasePlayer()
        super.onDestroy()
    }
}
